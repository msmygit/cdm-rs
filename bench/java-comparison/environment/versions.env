# Pinned versions for the tier-3 Java CDM comparison (`NFR-004`, `TST-060`).
#
# Every script in this directory sources this file, and nothing in this directory names a version
# anywhere else. A benchmark whose baseline drifts is not a baseline, and the Spark/Scala/JDK
# triple in particular is not free to drift: the wrong combination produces
#
#     java.lang.NoSuchMethodError: 'void scala.runtime.Statics.releaseFence()'
#
# which is the single most common Java CDM support issue (README.md, docs/SPEC.md §75). Scala
# 2.13's `Statics.releaseFence` does not exist in 2.12, so a jar compiled against a 2.13 Spark
# that lands on a 2.12 Spark distribution fails at the first RDD touch, minutes into a run.
#
# The versions below are not a guess. They are the values in Java CDM 6.0.1's own `pom.xml`
# (`scala.version`, `spark.version`) and its README's "Prerequisite CDM 6.x+" section. Read them
# as: this jar was compiled against exactly this Spark, so run it on exactly this Spark.

# --- Java CDM ------------------------------------------------------------------------------------

# 6.0.x is the baseline cdm-rs supersedes (`docs/SPEC.md`, `docs/MIGRATION_FROM_JAVA.md`), so the
# comparison must be against a 6.0.x release rather than whatever is newest. 6.0.1 is the latest
# 6.0.x and the first 6.0.x to publish a jar asset (6.0.0 published none).
CDM_VERSION=6.0.1
CDM_JAR=cassandra-data-migrator-${CDM_VERSION}.jar
CDM_JAR_URL=https://github.com/datastax/cassandra-data-migrator/releases/download/${CDM_VERSION}/${CDM_JAR}
# Apache 2.0. Verified against the release asset on 2026-08-14; 24,120,124 bytes.
CDM_JAR_SHA512=827e94463be17f412b3ed8a42af7b695071881f27e5abf18bbeca6804a2a0dca1054e8ea6ab4dd8cd759954de35b1709f1de96d6752008d239d31326464d4ef0

# --- Spark ---------------------------------------------------------------------------------------

# `pom.xml` <spark.version>4.1.2</spark.version>. The README's CDM 6.x prerequisite names the same
# version and the same archive. Do not "upgrade" to 4.1.3 or 4.2.0 without re-running the smoke
# test: the shaded jar carries Spark's own classes' expectations with it.
SPARK_VERSION=4.1.2
# `pom.xml` <scala.version>2.13.18</scala.version>. Spark 4.x ships only a Scala 2.13 build, so
# unlike the 3.5.x line there is no `-scala2.13` suffix to get wrong -- one fewer way to fail.
SCALA_VERSION=2.13.18
SPARK_TGZ=spark-${SPARK_VERSION}-bin-hadoop3.tgz
SPARK_URL=https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/${SPARK_TGZ}
# Published by the ASF next to the artifact at ${SPARK_URL}.sha512. 572,818,974 bytes.
SPARK_SHA512=490510e13e97da9493302bb33a802574bc417fcc107441419d1a0f87f2b372000db6e26f831a2bf92bc4b18bdf2c9023b1b6f2d021afdc7d6c19c8a11c03e685

# --- JDK -----------------------------------------------------------------------------------------

# CDM 6.x requires Java 17 minimum "as Spark 4.x binaries are compiled with it". 17 rather than 21
# or 25 because it is the floor the jar was tested against; a newer LTS is permitted by the README
# but adds a variable to a comparison that already has enough of them.
#
# The JRE, not the JDK: nothing here compiles Java. That is ~100 MiB of image saved.
JDK_IMAGE=eclipse-temurin:17.0.19_10-jre-noble

# --- Cassandra -----------------------------------------------------------------------------------

# Must match `crates/cdm-testkit/src/containers.rs`, or the two implementations are not being
# measured against the same database. `DEFAULT_ENGINE` there is `cassandra:5.0`, and the heap
# settings below are `DEFAULT_HEAP_MIB` (1024) and its documented `HEAP_NEWSIZE = heap/4`.
#
# `MAX_HEAP_SIZE` and `HEAP_NEWSIZE` are set together or not at all: `cassandra-env.sh` aborts
# with "please set or unset MAX_HEAP_SIZE and HEAP_NEWSIZE in pairs" when only one is set under
# CMS. 5.0 runs G1 and ignores `HEAP_NEWSIZE`, but setting both is the spelling that works across
# the whole 3.11/4.0/4.1/5.0 matrix, so it is the spelling used here too.
CASSANDRA_IMAGE=cassandra:5.0
CASSANDRA_HEAP_MIB=1024
CASSANDRA_NEWSIZE_MIB=256

# --- Container and network naming ----------------------------------------------------------------

# A fixed subnet with fixed addresses, because Cassandra advertises an *address* in
# `system.local.rpc_address` and the driver honours it. Container names would not do: the value has
# to be an IP the Spark driver can route to. See README-ENVIRONMENT.md, "Networking".
BENCH_NETWORK=cdm-bench-net
BENCH_SUBNET=172.28.0.0/16
ORIGIN_CONTAINER=cdm-bench-origin
ORIGIN_IP=172.28.0.11
TARGET_CONTAINER=cdm-bench-target
TARGET_IP=172.28.0.12
NATIVE_PORT=9042

# The image these scripts build. Tagged with both component versions so that a stale image from an
# earlier pinning cannot be silently reused.
BENCH_IMAGE=cdm-bench/java-cdm:${CDM_VERSION}-spark${SPARK_VERSION}
