CREATE KEYSPACE IF NOT EXISTS cdm_diff WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};
CREATE TYPE IF NOT EXISTS cdm_diff.diff_address (street text, zip int);
CREATE TYPE IF NOT EXISTS cdm_diff.diff_contact (label text, address frozen<diff_address>, aliases frozen<set<text>>);
CREATE TYPE IF NOT EXISTS cdm_diff.diff_person (name text, contacts frozen<list<frozen<diff_contact>>>);
CREATE TABLE IF NOT EXISTS cdm_diff.all_types (pk text, ck int, ck_text text, c_ascii ascii, c_bigint bigint, c_blob blob, c_boolean boolean, c_date date, c_decimal decimal, c_double double, c_duration duration, c_float float, c_inet inet, c_int int, c_smallint smallint, c_text text, c_time time, c_timestamp timestamp, c_timeuuid timeuuid, c_tinyint tinyint, c_uuid uuid, c_varint varint, c_list_int list<int>, c_set_text set<text>, c_map_text_int map<text, int>, c_tuple_int_text tuple<int, text>, c_frozen_list_int frozen<list<int>>, c_frozen_map_text_int frozen<map<text, int>>, c_list_frozen_set_int list<frozen<set<int>>>, c_set_tuple_int_text set<tuple<int, text>>, c_map_text_frozen_list_frozen_set_int map<text, frozen<list<frozen<set<int>>>>>, c_tuple_int_frozen_list_frozen_map_text_int tuple<int, frozen<list<frozen<map<text, int>>>>>, c_frozen_diff_address frozen<diff_address>, c_list_frozen_diff_address list<frozen<diff_address>>, c_frozen_diff_person frozen<diff_person>, PRIMARY KEY ((pk), ck, ck_text));
CREATE TABLE IF NOT EXISTS cdm_diff.counters (pk text, ck int, c_hits counter, c_misses counter, PRIMARY KEY ((pk), ck));
