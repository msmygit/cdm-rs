cdm_partitions_failed_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 0
# HELP cdm_rows_total Rows that crossed the wire, per side.
# TYPE cdm_rows_total counter
cdm_rows_total{run_id="1712345678901234",job="migrate",side="origin",node_id="node-a",keyspace="target_ks",table="orders"} 1000000
cdm_rows_total{run_id="1712345678901234",job="migrate",side="target",node_id="node-a",keyspace="target_ks",table="orders"} 999998
# HELP cdm_bytes_total Bytes that crossed the wire, per side.
# TYPE cdm_bytes_total counter
cdm_bytes_total{run_id="1712345678901234",job="migrate",side="origin",node_id="node-a",keyspace="target_ks",table="orders"} 64000000
cdm_bytes_total{run_id="1712345678901234",job="migrate",side="target",node_id="node-a",keyspace="target_ks",table="orders"} 0
