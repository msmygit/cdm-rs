# HELP cdm_ranges_planned Token ranges in the plan.
# TYPE cdm_ranges_planned gauge
cdm_ranges_planned{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 4
# HELP cdm_ranges Token ranges in each state. Terminal states use the TRK-012 spellings.
# TYPE cdm_ranges gauge
cdm_ranges{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders",state="pending"} 0
cdm_ranges{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders",state="in_flight"} 1
cdm_ranges{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders",state="PASS"} 3
# HELP cdm_progress_ratio Completed weight over planned weight, weighted by token span or size estimate.
# TYPE cdm_progress_ratio gauge
cdm_progress_ratio{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 0.750
# HELP cdm_progress_ranges_ratio Completed ranges over planned ranges, unweighted.
# TYPE cdm_progress_ranges_ratio gauge
cdm_progress_ranges_ratio{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 0.750
# HELP cdm_run_elapsed_seconds Wall-clock seconds since the run started.
# TYPE cdm_run_elapsed_seconds gauge
cdm_run_elapsed_seconds{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 30.000
# HELP cdm_eta_seconds Estimated seconds to completion. Absent until the estimate is worth having.
# TYPE cdm_eta_seconds gauge
cdm_eta_seconds{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 10.000
