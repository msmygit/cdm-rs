---
source: crates/cdm-metrics/src/export/prometheus.rs
expression: render(&sample_report())
---
# HELP cdm_read_total Rows read from the origin.
# TYPE cdm_read_total counter
cdm_read_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 1000000
# HELP cdm_write_total Rows written to the target and flushed.
# TYPE cdm_write_total counter
cdm_write_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 999998
# HELP cdm_skipped_total Rows a filter rejected, or that produced no statement.
# TYPE cdm_skipped_total counter
cdm_skipped_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 2
# HELP cdm_error_total Rows a failed token range could not account for.
# TYPE cdm_error_total counter
cdm_error_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 0
# HELP cdm_partitions_passed_total Token ranges that completed successfully.
# TYPE cdm_partitions_passed_total counter
cdm_partitions_passed_total{run_id="1712345678901234",job="migrate",node_id="node-a",keyspace="target_ks",table="orders"} 3
# HELP cdm_partitions_failed_total Token ranges that failed.
