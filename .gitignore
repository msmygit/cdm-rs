/target
**/*.rs.bk
*.pdb

# mdBook output (docs/book/book.toml sets build-dir = "book") and the mermaid runtime
# that `mdbook-mermaid install` vendors into the book root. Both are build artefacts;
# `just book` and the Docs workflow regenerate them.
/docs/book/book/
/docs/book/mermaid.min.js
/docs/book/mermaid-init.js

# Local run artefacts
/cdm_logs/
/reports/
*.profraw
lcov.info

# Local configuration that may contain secrets
cdm.local.*
*.secret.*
.env

# Editors / OS
.idea/
.vscode/
.DS_Store

# Generated during local integration runs
/tests/local/
