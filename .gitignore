/target
**/*.rs.bk
*.pdb

# mdBook output (docs/book/book.toml sets build-dir = "book") and the mermaid runtime
# that `mdbook-mermaid install` vendors into the book root. Both are build artefacts;
# `just book` and the Docs workflow regenerate them.
/docs/book/book/
/docs/book/mermaid.min.js
/docs/book/mermaid-init.js

# Local run artefacts
/cdm_logs/
/reports/
# Tier-3 benchmark output: one directory per run, holding Spark logs that reach tens of megabytes.
# The workflow uploads them as an artefact; they are evidence, not source.
/bench/java-comparison/results/
*.profraw
lcov.info

# Local configuration that may contain secrets
cdm.local.*
*.secret.*
.env

# Editors / OS
.idea/
.vscode/
.DS_Store

# Generated during local integration runs
/tests/local/

# Scratch git worktrees. A full second checkout of the repo lands here, so leaving it untracked
# but unignored means every `git status` and every `--all-files` lint sweep walks into it.
/.claude/worktrees/
